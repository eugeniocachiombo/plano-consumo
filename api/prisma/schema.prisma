generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String?
  username String  @unique @default("empty")
  password String  @default("empty")
}

model Category {
  id       Int     @id @default(autoincrement())
  name     String
}